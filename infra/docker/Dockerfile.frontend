FROM node:22-alpine

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app/frontend

# enable pnpm through corepack instead of installing it separately in the image
RUN corepack enable

# copy dependency manifests first so docker can cache installs between source edits
COPY frontend/package.json ./package.json
COPY frontend/pnpm-lock.yaml ./pnpm-lock.yaml
COPY frontend/.npmrc ./.npmrc
COPY frontend/pnpm-workspace.yaml ./pnpm-workspace.yaml

RUN pnpm install --frozen-lockfile

# copy the frontend source after dependencies are installed
COPY frontend ./

EXPOSE 5173

# run vite in dev mode for the local compose workflow
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]